# Postgres connection (Supabase pooler URL)
DATABASE_URL=

# Supabase browser client configuration (publishable, not secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only email provider credential
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MEMBERSHIP_NOTIFICATION_EMAIL=

# Auth.js/NextAuth session secret (replaced by Supabase Auth at cutover)
AUTH_SECRET=

# Base URL of the app's own API routes used by client fetch helpers
NEXT_PUBLIC_API_ROUTE=http://localhost:3000/api

# TLS verification for the database connection. NEVER set to false in production.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
